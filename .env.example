# Template variabel lingkungan publik.
# Salin ke .env untuk pengembangan lokal.
# Jangan tulis kredensial rahasia di berkas ini.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GA_MEASUREMENT_ID=
VITE_ICECAST_STREAM_URL=
# Base path publik. Kosongkan untuk memakai "/" (default repo <org>.github.io).
# Isi hanya bila domain kustom dipakai dengan folder, misalnya /radio/.
VITE_BASE_PATH=
