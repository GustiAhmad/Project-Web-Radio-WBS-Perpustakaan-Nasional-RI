# Template variabel lingkungan publik.
# Salin ke .env untuk pengembangan lokal.
# Jangan tulis kredensial rahasia di berkas ini.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GA_MEASUREMENT_ID=
VITE_ICECAST_STREAM_URL=
# Base path publik. Kosongkan untuk GitHub Pages project site (default panjang).
# Isi "/" untuk Vercel, domain kustom, atau repo <username>.github.io.
# Di Vercel base "/" terdeteksi otomatis dari variabel VERCEL.
VITE_BASE_PATH=
